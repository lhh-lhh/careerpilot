{
  "name": "careerpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "predev": "node scripts/build-validators.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "prebuild": "node scripts/build-validators.mjs",
    "build": "vite build",
    "start": "tsx server/cli.ts start",
    "start:demo": "node scripts/start-demo.mjs",
    "start:online": "tsx server/cli.ts start",
    "init:online": "tsx server/cli.ts init",
    "password:online": "tsx server/cli.ts password",
    "backup:online": "tsx server/cli.ts backup",
    "restore:online": "tsx server/cli.ts restore",
    "test:online": "vitest run tests/unit/online.test.ts",
    "opportunities:online": "tsx scripts/sync-opportunities.ts",
    "start:project": "node scripts/start-project.mjs",
    "setup:gateway": "node scripts/setup-gateway.mjs",
    "build:demo": "npm run build && node scripts/build-demo.mjs",
    "build:source": "node scripts/build-source.mjs",
    "build:release": "npm run build && node scripts/build-demo.mjs && node scripts/build-source.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --grep-invert PERF0",
    "test:delivery": "vitest run tests/unit/delivery.test.ts",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "verify:seed": "node scripts/verify-seed.mjs",
    "test:perf": "playwright test performance.spec.ts --workers=1",
    "test:load:online": "tsx scripts/measure-online.ts",
    "test:gateway": "node scripts/test-gateway.mjs"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "2.1.0",
    "dexie": "4.4.7",
    "echarts": "6.1.0",
    "pdfjs-dist": "6.5.438",
    "pinia": "3.0.4",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "vue": "3.5.45",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.12.1",
    "fake-indexeddb": "6.2.8",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
