  <Box style={{ flex: 1, height: 720, padding: '44px 52px 40px 48px', flexDirection: 'column' }}>
    <Text style={{ fontSize: 13, color: '#6E56CF', letterSpacing: 3, fontWeight: 'bold' }}>04 · AI 接入与应用</Text>
    <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#10366B', marginTop: 8 }}>AI 接入：服务端代理，不把模型当业务核心</Text>
    <Box style={{ height: 1, background: '#D9E3F2', marginTop: 14 }} />
    <Box style={{ marginTop: 18, flexDirection: 'row', alignItems: 'stretch', gap: 12 }}>
      <Box style={{ flex: 1, background: '#F3F0FD', border: '1px solid #D8CDF2', borderRadius: 8, padding: '12px 14px' }}>
